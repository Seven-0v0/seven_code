File          : rm_c_blinky.jdebug
Created       : 05. Sep 2026 18:08
Ozone Version : V3.50a

Notes
  This project file is committed to the repository at
  apps/rm_c_blinky/ozone/rm_c_blinky.jdebug. It contains only shared,
  machine-independent project settings and must not be edited to add
  a developer's local home-directory path. Per-user Ozone state (view
  layout, window positions, last-used breakpoints) belongs in the
  Ozone-generated ".jdebug.user" sidecar file, which is intentionally
  not part of this repository file and should not be committed.

  All paths below are resolved relative to $(ProjectDir), i.e. this
  file's own directory (apps/rm_c_blinky/ozone/). That keeps the
  project portable across clones and machines: anyone who runs
  `bash tools/launch_ozone.sh` (or `--build-only` to just produce the
  ELF without starting Ozone) gets the canonical
  build-rm_dev_board_c-debug/apps/rm_c_blinky/rm_c_blinky.elf that this
  file opens, with no manual path edits.

  Do not use `tools/build_and_flash.sh` or a bare `cmake --build` to
  produce this ELF: the CMake target has no file extension by default,
  and only tools/launch_ozone.sh performs the copy step that creates
  the `.elf`-suffixed file this project expects.
*/

/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.SetDevice ("STM32F407IG");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M4F.svd");
  //
  // User settings
  //
  Edit.SysVar (VAR_HSS_SPEED, FREQ_100_HZ);
  File.Open ("$(ProjectDir)/../../../build-rm_dev_board_c-debug/apps/rm_c_blinky/rm_c_blinky.elf");
  Project.SetOSPlugin ("FreeRTOSPlugin_Cortex-M");
  //
  // Watched data: the debugger-visible gyro snapshot (see
  // apps/rm_c_blinky/src/gyro_snapshot.h / gyro_task.c). These are raw
  // struct-field expressions, not a generation-safe read: g_gyro_snapshot
  // uses a single-writer/multi-reader generation protocol so a torn
  // read across fields is possible if the task publishes mid-observation.
  // Before trusting a set of values together, check that
  // g_gyro_snapshot.generation is even and unchanged before/after reading
  // the payload fields, exactly as gyro_snapshot_read() does in firmware.
  //
  Window.Add ("Watched Data 1", "g_gyro_snapshot.generation");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.sequence");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.init_status");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.read_error_count");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.last_read_status");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.gyro_sample_valid");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.x_mdps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.y_mdps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.z_mdps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_init_status");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.last_accel_read_status");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_read_error_count");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.last_temperature_status");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.temperature_mdeg_c");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.heater_state");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.heater_fault");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.heater_duty");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.heater_stable_time_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.sample_dt_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.skipped_cycles");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.temperature_degc");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.temperature_slope_degc_per_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.temperature_valid");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.sample_stationary");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.stack_high_water_words");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.experiment_phase");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibration_reset_count");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_accepted_samples");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.experiment_phase_elapsed_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.experiment_phase_required_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_wall_duration_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_accepted_duration_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_unobserved_duration_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.bias_frozen");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_valid");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_x_ug");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_y_ug");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_z_ug");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_x_g");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_y_g");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.accel_z_g");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_gyro_bias_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_gyro_bias_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_gyro_bias_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_velocity_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_velocity_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_velocity_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_acceleration_x_dps2");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_acceleration_y_dps2");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.angular_acceleration_z_dps2");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.quaternion_w");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.quaternion_x");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.quaternion_y");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.quaternion_z");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.roll_deg");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.pitch_deg");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.yaw_deg");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibration_accepted_samples");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibration_complete");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_gyro_bias_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_gyro_bias_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.hold_out_gyro_bias_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_sample_count");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_observed_duration_s");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_mean_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_mean_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_mean_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_rms_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_rms_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.drift_rms_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.yaw_drift_deg");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.yaw_drift_deg_per_min");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_mean_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_mean_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_mean_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_rms_x_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_rms_y_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_drift_rms_z_dps");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_yaw_drift_deg");
  Window.Add ("Watched Data 1", "g_gyro_snapshot.payload.calibrated_yaw_drift_deg_per_min");
}

